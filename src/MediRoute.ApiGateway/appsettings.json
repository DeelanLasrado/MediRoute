{
  "ReverseProxy": {
    "Routes": {
      "triage-route": {
        "ClusterId": "triage-cluster",
        "Match": { "Path": "/api/triage/{**catch-all}" }
      },
      "hospitals-route": {
        "ClusterId": "hospital-cluster",
        "Match": { "Path": "/api/hospitals/{**catch-all}" }
      },
      "auth-route": {
        "ClusterId": "hospital-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "ambulances-route": {
        "ClusterId": "hospital-cluster",
        "Match": { "Path": "/api/ambulances/{**catch-all}" }
      },
      "emergencies-route": {
        "ClusterId": "hospital-cluster",
        "Match": { "Path": "/api/emergencies/{**catch-all}" }
      },
      "routing-route": {
        "ClusterId": "routing-cluster",
        "Match": { "Path": "/api/routing/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "signalr-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "triage-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5001" }
        }
      },
      "hospital-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5002" }
        }
      },
      "routing-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5003" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5004" }
        }
      }
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
